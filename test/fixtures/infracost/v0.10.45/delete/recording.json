{
  "scenario": "delete",
  "description": "A deployed aws_instance taken out of the code: the change saves what it cost a month.",
  "cliVersion": "v0.10.45",
  "commands": [
    {
      "id": "plan",
      "argv": [
        "tofu",
        "plan",
        "-input=false",
        "-no-color",
        "-refresh=false",
        "-json",
        "-out={plan}"
      ],
      "cwd": "compute",
      "exitCode": 0,
      "stdout": "plan.stdout",
      "stderr": "plan.stderr",
      "stdoutFormat": "text"
    },
    {
      "id": "show",
      "argv": [
        "tofu",
        "show",
        "-json",
        "-no-color",
        "{plan}"
      ],
      "cwd": "compute",
      "exitCode": 0,
      "stdout": "show.stdout",
      "stderr": "show.stderr",
      "stdoutFormat": "json"
    },
    {
      "id": "diff",
      "argv": [
        "infracost",
        "diff",
        "--path",
        "plan.json",
        "--format",
        "json",
        "--no-color"
      ],
      "cwd": "{plan-dir}",
      "exitCode": 0,
      "stdout": "diff.stdout",
      "stderr": "diff.stderr",
      "stdoutFormat": "json"
    }
  ]
}
