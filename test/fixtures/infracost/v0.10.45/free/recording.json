{
  "scenario": "free",
  "description": "network:dev before its first deploy: creates of resources the pricing API has no price for, so the change costs about the same.",
  "cliVersion": "v0.10.45",
  "commands": [
    {
      "id": "plan",
      "argv": [
        "tofu",
        "plan",
        "-input=false",
        "-no-color",
        "-refresh=false",
        "-json",
        "-out={plan}",
        "-var-file=dev.tfvars"
      ],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "plan.stdout",
      "stderr": "plan.stderr",
      "stdoutFormat": "text",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    },
    {
      "id": "show",
      "argv": [
        "tofu",
        "show",
        "-json",
        "-no-color",
        "{plan}"
      ],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "show.stdout",
      "stderr": "show.stderr",
      "stdoutFormat": "json",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    },
    {
      "id": "diff",
      "argv": [
        "infracost",
        "diff",
        "--path",
        "plan.json",
        "--format",
        "json",
        "--no-color"
      ],
      "cwd": "{plan-dir}",
      "exitCode": 0,
      "stdout": "diff.stdout",
      "stderr": "diff.stderr",
      "stdoutFormat": "json"
    }
  ]
}
