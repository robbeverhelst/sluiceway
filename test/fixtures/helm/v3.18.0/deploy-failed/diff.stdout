[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "namespace": "sluiceway-web",
    "name": "web",
    "changeType": "MODIFY",
    "resourceStatus": {
      "oldExists": true,
      "newExists": true
    },
    "changes": [
      {
        "path": "spec.ports[0]",
        "field": "port",
        "change": "replace",
        "oldValue": 80,
        "newValue": 99999
      }
    ]
  }
]
