{
  "scenario": "drift-hooks",
  "description": "A chart with a hook that deletes itself once it ran, deployed, and nothing changed. The hook is not in the cluster, and it is no drift.",
  "cliVersion": "v3.18.0",
  "commands": [
    {
      "id": "diff",
      "argv": [
        "helm",
        "diff",
        "upgrade",
        "web",
        "../charts/web",
        "--namespace=sluiceway-web",
        "--install",
        "--reset-values",
        "--dry-run=server",
        "--output=structured",
        "--no-color",
        "--values=values.yaml"
      ],
      "cwd": "web",
      "exitCode": 0,
      "stdout": "diff.stdout",
      "stderr": "diff.stderr",
      "stdoutFormat": "json"
    },
    {
      "id": "diff-again",
      "argv": [
        "helm",
        "diff",
        "upgrade",
        "web",
        "../charts/web",
        "--namespace=sluiceway-web",
        "--install",
        "--reset-values",
        "--dry-run=server",
        "--output=structured",
        "--no-color",
        "--values=values.yaml"
      ],
      "cwd": "web",
      "exitCode": 0,
      "stdout": "diff-again.stdout",
      "stderr": "diff-again.stderr",
      "stdoutFormat": "json"
    },
    {
      "id": "three-way",
      "argv": [
        "helm",
        "diff",
        "upgrade",
        "web",
        "../charts/web",
        "--namespace=sluiceway-web",
        "--install",
        "--reset-values",
        "--dry-run=server",
        "--three-way-merge",
        "--no-hooks",
        "--output=structured",
        "--no-color",
        "--values=values.yaml"
      ],
      "cwd": "web",
      "exitCode": 0,
      "stdout": "three-way.stdout",
      "stderr": "three-way.stderr",
      "stdoutFormat": "json"
    }
  ]
}
