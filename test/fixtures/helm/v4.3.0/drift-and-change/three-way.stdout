[
  {
    "apiVersion": "v1",
    "kind": "Service",
    "namespace": "sluiceway-web",
    "name": "web",
    "changeType": "MODIFY",
    "resourceStatus": {
      "oldExists": true,
      "newExists": true
    },
    "changes": [
      {
        "path": "spec.ports[0]",
        "field": "port",
        "change": "replace",
        "oldValue": 80,
        "newValue": 8080
      }
    ]
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "namespace": "sluiceway-web",
    "name": "web-settings",
    "changeType": "MODIFY",
    "resourceStatus": {
      "oldExists": true,
      "newExists": true
    },
    "changes": [
      {
        "path": "data",
        "field": "app.properties",
        "change": "replace",
        "oldValue": "color=blue\n",
        "newValue": "color=green\n"
      },
      {
        "path": "data",
        "field": "greeting",
        "change": "replace",
        "oldValue": "CANARY-VALUE drifted",
        "newValue": "CANARY-VALUE hello"
      }
    ]
  }
]
