{
  "scenario": "changed-secret",
  "description": "The sensitive variable rotated: an update of terraform_data and a replace of null_resource, at sensitive paths.",
  "cliVersion": "v1.12.6",
  "commands": [
    {
      "id": "plan",
      "argv": [
        "tofu",
        "plan",
        "-input=false",
        "-no-color",
        "-refresh=false",
        "-json",
        "-out={plan}",
        "-var-file=dev.tfvars"
      ],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "plan.stdout",
      "stderr": "plan.stderr",
      "stdoutFormat": "text",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    },
    {
      "id": "show",
      "argv": [
        "tofu",
        "show",
        "-json",
        "-no-color",
        "{plan}"
      ],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "show.stdout",
      "stderr": "show.stderr",
      "stdoutFormat": "json",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    }
  ]
}
