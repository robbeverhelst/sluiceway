{
  "scenario": "other-workspace",
  "description": "network:prod, the same root module in the workspace prod with its own var file.",
  "cliVersion": "v1.12.6",
  "commands": [
    {
      "id": "plan",
      "argv": [
        "tofu",
        "plan",
        "-input=false",
        "-no-color",
        "-refresh=false",
        "-json",
        "-out={plan}",
        "-var-file=prod.tfvars"
      ],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "plan.stdout",
      "stderr": "plan.stderr",
      "stdoutFormat": "text",
      "env": {
        "TF_WORKSPACE": "prod"
      }
    },
    {
      "id": "show",
      "argv": [
        "tofu",
        "show",
        "-json",
        "-no-color",
        "{plan}"
      ],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "show.stdout",
      "stderr": "show.stderr",
      "stdoutFormat": "json",
      "env": {
        "TF_WORKSPACE": "prod"
      }
    }
  ]
}
