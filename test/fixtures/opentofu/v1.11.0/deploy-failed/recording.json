{
  "scenario": "deploy-failed",
  "description": "A plan that works and a deploy that fails: a provisioner of a new resource exits with 3.",
  "cliVersion": "v1.11.0",
  "commands": [
    {
      "id": "plan",
      "argv": [
        "tofu",
        "plan",
        "-input=false",
        "-no-color",
        "-refresh=false",
        "-json",
        "-out={plan}",
        "-var-file=dev.tfvars"
      ],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "plan.stdout",
      "stderr": "plan.stderr",
      "stdoutFormat": "text",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    },
    {
      "id": "show",
      "argv": ["tofu", "show", "-json", "-no-color", "{plan}"],
      "cwd": "network",
      "exitCode": 0,
      "stdout": "show.stdout",
      "stderr": "show.stderr",
      "stdoutFormat": "json",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    },
    {
      "id": "apply",
      "argv": ["tofu", "apply", "-input=false", "-no-color", "-json", "{plan}"],
      "cwd": "network",
      "exitCode": 1,
      "stdout": "apply.stdout",
      "stderr": "apply.stderr",
      "stdoutFormat": "text",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    }
  ]
}
