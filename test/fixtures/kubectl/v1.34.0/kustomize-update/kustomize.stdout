apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/name: cache
  name: cache
  namespace: sluiceway-example
spec:
  ports:
  - name: redis
    port: 6379
  selector:
    app.kubernetes.io/name: cache
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/name: cache
  name: cache
  namespace: sluiceway-example
spec:
  replicas: 3
  selector:
    matchLabels:
      app.kubernetes.io/name: cache
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cache
    spec:
      containers:
      - args:
        - --note=CANARY-VALUE
        image: registry.k8s.io/pause:3.10
        name: cache
