{
  "scenario": "removed-object",
  "description": "The ConfigMap taken out of the manifests: without pruning kubectl leaves it, and the diff is empty.",
  "cliVersion": "v1.34.0",
  "commands": [
    {
      "id": "diff",
      "argv": [
        "kubectl",
        "diff",
        "--server-side",
        "--namespace=sluiceway-example",
        "-f",
        "{plan}"
      ],
      "cwd": "web",
      "exitCode": 0,
      "stdout": "diff.stdout",
      "stderr": "diff.stderr",
      "stdoutFormat": "diff",
      "env": {
        "KUBECTL_EXTERNAL_DIFF": "diff -N -U1000000"
      }
    }
  ]
}
