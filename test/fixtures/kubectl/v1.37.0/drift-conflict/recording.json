{
  "scenario": "drift-conflict",
  "description": "web deployed, then scaled by hand: without forceConflicts the preview meets the conflict, as a deploy would.",
  "cliVersion": "v1.37.0",
  "commands": [
    {
      "id": "diff",
      "argv": [
        "kubectl",
        "diff",
        "--server-side",
        "--namespace=sluiceway-example",
        "-f",
        "{plan}"
      ],
      "cwd": "web",
      "exitCode": 2,
      "stdout": "diff.stdout",
      "stderr": "diff.stderr",
      "stdoutFormat": "diff",
      "env": {
        "KUBECTL_EXTERNAL_DIFF": "diff -N -U1000000"
      }
    }
  ]
}
