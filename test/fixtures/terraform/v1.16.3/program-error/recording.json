{
  "scenario": "program-error",
  "description": "A resource block that is never closed: the plan fails with diagnostics in its JSON log.",
  "cliVersion": "v1.16.3",
  "commands": [
    {
      "id": "plan",
      "argv": [
        "terraform",
        "plan",
        "-input=false",
        "-no-color",
        "-refresh=false",
        "-json",
        "-out={plan}",
        "-var-file=dev.tfvars"
      ],
      "cwd": "network",
      "exitCode": 1,
      "stdout": "plan.stdout",
      "stderr": "plan.stderr",
      "stdoutFormat": "text",
      "env": {
        "TF_WORKSPACE": "dev"
      }
    }
  ]
}
