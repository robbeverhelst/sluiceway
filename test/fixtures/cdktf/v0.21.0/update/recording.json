{
  "scenario": "update",
  "description": "A new input of terraform_data in the app, synthesized again: an update in place.",
  "cliVersion": "v0.21.0",
  "commands": [
    {
      "id": "plan",
      "argv": [
        "tofu",
        "plan",
        "-input=false",
        "-no-color",
        "-refresh=false",
        "-json",
        "-out={plan}"
      ],
      "cwd": "cdktf.out/stacks/dev",
      "exitCode": 0,
      "stdout": "plan.stdout",
      "stderr": "plan.stderr",
      "stdoutFormat": "text"
    },
    {
      "id": "show",
      "argv": [
        "tofu",
        "show",
        "-json",
        "-no-color",
        "{plan}"
      ],
      "cwd": "cdktf.out/stacks/dev",
      "exitCode": 0,
      "stdout": "show.stdout",
      "stderr": "show.stderr",
      "stdoutFormat": "json"
    }
  ]
}
